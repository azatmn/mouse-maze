@startuml activity_attempt
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
title Диаграмма деятельности: одна попытка мыши

start
:Мышь на старте, очки = 0,\nвся вода на месте;
repeat
  if (случайное число < ε?) then (да)
    :Направление наугад;
  else (нет)
    :Направление с наибольшим Q\n(из равных — случайное);
  endif
  if (в этом направлении стена?) then (да)
    :Остаться на месте;
    :награда = удар о стену;
  else (нет)
    :Перейти в соседнюю клетку;
    :награда = плата за шаг;
    if (в клетке сыр?) then (да)
      :награда += сыр;
    elseif (в клетке невыпитая вода?) then (да)
      :награда += вода;
      :отметить воду выпитой;
    elseif (в клетке ток?) then (да)
      :награда += ток;
    else (пусто)
    endif
  endif
  :очки += награда;
  :Q[s][a] += α · (награда + γ · max Q[s'] − Q[s][a])\n(у сыра будущего нет: max Q[s'] = 0);
repeat while (не сыр и шагов < лимита?) is (да)
->нет;
:Сумма попытки → история (график);
:Проверить автостоп:\nлучший путь не менялся N попыток?;
stop
@enduml
