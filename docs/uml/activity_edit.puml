@startuml activity_edit
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
title Диаграмма деятельности: клик в редакторе

start
:Клик по лабиринту в точке (x, y);
:Перевести пиксели в клетку;
if (точка вне лабиринта?) then (да)
  :Ничего не менять;
  stop
endif
switch (инструмент?)
case (Стена)
  if (клик у границы клеток\n(20% клетки)?) then (да)
    if (граница лабиринта?) then (да)
      :Отказ: «граница — всегда стена»;
      stop
    else (нет)
      :Поставить или убрать стену;
    endif
  else (нет)
    :Ничего не менять;
    stop
  endif
case (Вода / Ток)
  if (старт или сыр?) then (да)
    :Отказ: «на старт и сыр\nничего класть нельзя»;
    stop
  else (нет)
    :Положить (или убрать тот же предмет);
  endif
case (Старт / Сыр)
  if (занято другим (сыр / старт)?) then (да)
    :Отказ;
    stop
  else (нет)
    :Перенести; предмет в клетке пропадает;
  endif
case (Ластик)
  :Убрать стену или предмет;
endswitch
:Лабиринт изменён → обучение сбрасывается, пауза;
if (сыр достижим?) then (нет)
  :Показать «Сыр недостижим»;
endif
stop
@enduml
