@startuml state_mouse
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
title Диаграмма состояний: мышь в одной попытке

[*] --> Старт
Старт --> Идёт : первый шаг
state "Идёт" as Идёт
state "Стоит у стены" as Стена
state "Пьёт воду" as Вода
state "Под током" as Ток
Идёт --> Идёт : пустая клетка / −1
Идёт --> Стена : шаг в стену / −5
Стена --> Идёт : шаг в проход
Стена --> Стена : снова в стену / −5
Идёт --> Вода : клетка с невыпитой водой / −1 +10
Вода --> Идёт : следующий шаг\n(вода выпита до конца попытки)
Идёт --> Ток : клетка с током / −1 −50
Ток --> Идёт : следующий шаг
Идёт --> Сыр : клетка с сыром / −1 +100
Идёт --> Лимит : шагов = лимиту
Сыр --> [*]
Лимит --> [*]
@enduml
